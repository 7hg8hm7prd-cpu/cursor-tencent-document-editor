{
  "name": "tencent-document-present",
  "displayName": "Tencent Document Present",
  "description": "Open md/html and Office (docx/pptx/xlsx/pdf) via Tencent editor_sdk / present UI by default.",
  "version": "1.1.0",
  "publisher": "tax-hermes",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:tencentDocument.present",
    "onCommand:tencentDocument.openPresent",
    "onCommand:tencentDocument.openSource"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "tencentDocument.present",
        "displayName": "文档可视化预览",
        "selector": [
          { "filenamePattern": "*.html" },
          { "filenamePattern": "*.htm" },
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.docx" },
          { "filenamePattern": "*.doc" },
          { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.xls" },
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.pptx" },
          { "filenamePattern": "*.ppt" },
          { "filenamePattern": "*.pdf" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "tencentDocument.openPresent",
        "title": "Document Present: 打开可视化预览",
        "icon": "$(preview)"
      },
      {
        "command": "tencentDocument.openSource",
        "title": "Document Present: 编辑源码",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tencentDocument.openSource",
          "when": "activeCustomEditorId == tencentDocument.present && resourceExtname =~ /\\.(md|markdown|html|htm)$/i",
          "group": "navigation"
        },
        {
          "command": "tencentDocument.openPresent",
          "when": "resourceExtname =~ /\\.(md|markdown|html|htm|docx|doc|xlsx|xls|csv|pptx|ppt|pdf)$/i && activeCustomEditorId != tencentDocument.present",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "tencentDocument.openPresent",
          "when": "resourceExtname =~ /\\.(md|markdown|html|htm|docx|doc|xlsx|xls|csv|pptx|ppt|pdf)$/i",
          "group": "navigation"
        },
        {
          "command": "tencentDocument.openSource",
          "when": "resourceExtname =~ /\\.(md|markdown|html|htm)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Tencent Document Present",
      "properties": {
        "tencentDocument.previewPort": {
          "type": "number",
          "default": 39110,
          "description": "Local md/html present HTTP port"
        },
        "tencentDocument.sdkPort": {
          "type": "number",
          "default": 39099,
          "description": "Local Tencent editor_sdk port (Office visual editor)"
        },
        "tencentDocument.pluginRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to tencent-document-editor plugin root (auto-set by install-local.sh)"
        }
      }
    }
  }
}
